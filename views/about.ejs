<%- include('partials/header', { pageTitle: 'من أنا', isAdmin: typeof isAdmin !== 'undefined' ? isAdmin : false }) %>

<div class="row">
    <div class="col-lg-8 mx-auto">
        <!-- Page Title -->
        <h1 class="text-center mb-4">الصفحة التعريفية</h1>

        <!-- If profile image is set in DB, show it larger here -->
        <% if (about && about.profileImage && about.profileImage.url) { %>
            <div class="text-center mb-4">
                <img src="<%= about.profileImage.url %>" alt="صورة شخصية" class="img-fluid rounded-circle shadow" style="max-width: 250px;">
            </div>
        <% } %>

        <!-- About Section -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h3 class="card-title">نبذة عني</h3>
                <p class="card-text" style="line-height: 1.8; white-space: pre-wrap;"><%= (about && about.intro) ? about.intro : 'بسم الله الرحمن الرحيم، أنا داعية إلى الله تعالى، أسعى لنشر العلم النافع والخير بين الناس.' %>
                </p>
            </div>
        </div>

        <!-- Page Snippet (نبذة عن الصفحة) -->
        <% if (about && about.snippet) { %>
            <div class="card mb-4">
                <div class="card-body">
                    <h3 class="card-title">نبذة عن الصفحة</h3>
                    <p class="card-text" style="white-space: pre-wrap;"><%= about.snippet %></p>
                </div>
            </div>
        <% } %>

        

        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <div class="text-center mb-4">
                <a href="/about/edit" class="btn btn-outline-secondary">تعديل الصفحة</a>
            </div>
        <% } %>

        <!-- Jobs/Roles Section -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h3 class="card-title">المناصب والأعمال</h3>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <i class="bi bi-bookmark-check"></i>
                        <strong>إمام وخطيب المسجد</strong> - أقوم بإمامة المصلين وإلقاء خطبة الجمعة
                    </li>
                    <li class="list-group-item">
                        <i class="bi bi-book"></i>
                        <strong>معلم القرآن الكريم</strong> - تحفيظ وتفسير كتاب الله
                    </li>
                    <li class="list-group-item">
                        <i class="bi bi-people"></i>
                        <strong>مرشد ديني</strong> - تقديم الاستشارات والنصائح الدينية
                    </li>
                    <li class="list-group-item">
                        <i class="bi bi-pencil-square"></i>
                        <strong>كاتب المقالات الأسبوعية</strong> - نشر مقالات دينية هادفة
                    </li>
                </ul>
            </div>
        </div>

        <!-- Masjid Location Section -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <h3 class="card-title">موقع المسجد</h3>
                <p class="text-muted">يمكنكم زيارتنا في المسجد للصلاة والدروس الدينية</p>
                
                <!-- Google Maps Embed -->
                <!-- <div class="ratio ratio-16x9 rounded overflow-hidden">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3623.9876543210!2d46.6753!3d24.7136!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjTCsDQyJzQ5LjAiTiA0NsKwNDAnMzEuMSJF!5e0!3m2!1sen!2ssa!4v1234567890123!5m2!1sen!2ssa" 
                        style="border:0;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div> -->
                <div class="ratio ratio-16x9 rounded overflow-hidden">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3478.5288940572286!2d47.92015770898269!3d29.325491865412026!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3fcf9b0d290fad21%3A0x771b252a89915b6!2z2YXYs9is2K8g2KXYqNix2KfZh9mK2YUg2KfZhNit2YjYp9mE!5e0!3m2!1sen!2skw!4v1763931086409!5m2!1sen!2skw" 
                        style="border:0;" 
                        allowfullscreen="" 
                        loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
                </div>
                <p class="text-center mt-3">
                    <small class="text-muted">
                        ملاحظة: يرجى تحديث الخريطة بالموقع الصحيح للمسجد
                    </small>
                </p>
            </div>
        </div>

        <!-- Contact Section (Optional) -->
        <div class="text-center mb-4">
            <a href="/weeklyletters" class="btn btn-primary">اطلع على المقالات الأسبوعية</a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
